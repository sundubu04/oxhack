# Copy to app/.env (gitignored) and fill in. The dev server reads it; the browser never sees the keys.
# Gemini: Google AI Studio -> Get API key (mlh.link/gemini-aistudio). Free tier covers the vector drawings and the Gemini voice.
GEMINI_API_KEY=
# Image models need billing on the key's Google Cloud project.
# Tried in order, best first; "model:thinking". The pro model needs billing on the project; each flash model
# has its own free quota of 20 requests a day.
GEMINI_MODELS=gemini-3.1-pro-preview:low,gemini-3.5-flash:minimal,gemini-3.8-flash:low,gemini-3.1-flash-lite:low
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# ElevenLabs: redeem the MLH promo code, then Developers -> API keys. When set, the arm speaks with ElevenLabs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE=JBFqnCBsd6RMkjVDRZzb
